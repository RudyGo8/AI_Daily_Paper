# Runtime
LOG_LEVEL=INFO
LOAD_DOTENV=true
TIMEZONE=Asia/Shanghai
CONFIG_DIR=configs

# RSS
RSS_TIMEOUT=20
DEDUP_SIMILARITY_THRESHOLD=0.88
MAX_ITEMS_PER_DAY=50

# LLM (OpenAI-compatible)
LLM_PROVIDER=dashscope
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.6-flash
LLM_TIMEOUT=60

# Feishu group bot
FEISHU_ENABLED=false
FEISHU_WEBHOOK_URL=
FEISHU_MESSAGE_TITLE=AI 日报

# GitHub collection (optional; CI injects GITHUB_TOKEN)
GH_API_TOKEN=
GITHUB_TIMEOUT=15

# Delivery history: local JSON by default, github data branch in CI
HISTORY_ENABLED=true
HISTORY_BACKEND=local
HISTORY_DIR=data/history
HISTORY_RETENTION_DAYS=30
HISTORY_BRANCH=information-hub-data
